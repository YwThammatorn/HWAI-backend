  "rubrics": [
    {
      "id": "r-mock-10",
      "assignmentId": "a-mock-10",
      "name": "เกณฑ์ตรวจโปรเจกต์ UX/UI ปลายภาค",
      "criteria": [
        {
          "id": "rc-uxui-1",
          "name": "C1 · Screen Completeness & Content Realism / ความครบถ้วนขององค์ประกอบและความสมจริงของเนื้อหา",
          "description": "องค์ประกอบของหน้าจอครบถ้วนและเนื้อหาสมจริงเพียงใด",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "องค์ประกอบที่จำเป็นตามหน้าจอและงานที่กำหนดครบถ้วน เนื้อหามีความสมจริง ไม่พึ่ง Lorem Ipsum หรือข้อมูลตัวแทนมากเกินไป"
            },
            {
              "label": "พอใช้",
              "description": "องค์ประกอบส่วนใหญ่ครบ มีรายละเอียดหรือเนื้อหาบางส่วนที่ยังไม่สมบูรณ์"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "มีองค์ประกอบสำคัญขาดหลายส่วน หรือมีเนื้อหาตัวแทน/Placeholder ที่เห็นได้ชัด"
            },
            {
              "label": "ไม่ผ่าน",
              "description": "ขาดองค์ประกอบสำคัญจำนวนมาก ทำให้หน้าจอไม่สมบูรณ์หรือไม่สามารถสื่อการใช้งานได้"
            }
          ]
        },
        {
          "id": "rc-uxui-2",
          "name": "C2 · Layout & Balance / การจัดวางและความสมดุลของหน้าจอ",
          "description": "การจัดวางหน้าจอสมดุลเหมาะกับเนื้อหาเพียงใด",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "การจัดวางมีความสมดุล ใช้พื้นที่เหมาะสมกับเนื้อหาและวัตถุประสงค์ของหน้าจอ ไม่มีพื้นที่ว่างหรือความหนาแน่นที่รบกวนการใช้งาน"
            },
            {
              "label": "พอใช้",
              "description": "โดยรวมสมดุล แต่มีบางบริเวณที่แน่นหรือโล่งเกินไปเล็กน้อย"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "มีปัญหาความสมดุลหลายบริเวณ ทำให้การอ่านหรือการใช้งานบางส่วนไม่สะดวก"
            },
            {
              "label": "ไม่ผ่าน",
              "description": "การจัดวางไม่สมดุลอย่างชัดเจน และส่งผลต่อความเข้าใจหรือการใช้งาน"
            }
          ]
        },
        {
          "id": "rc-uxui-3",
          "name": "C3 · Spacing, Alignment & Grid Pattern / ระยะห่าง การจัดแนว และรูปแบบ Grid",
          "description": "ความสม่ำเสมอของระยะห่าง การจัดแนว และ Grid",
          "maxPoints": 10,
          "weight": 10,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "ระยะห่าง การจัดแนว และ Grid มีรูปแบบที่ชัดเจนและสม่ำเสมอ องค์ประกอบต่าง ๆ อยู่ในแนวที่เป็นระบบ"
            },
            {
              "label": "พอใช้",
              "description": "โดยรวมมีรูปแบบสม่ำเสมอ แต่พบความคลาดเคลื่อนเล็กน้อยบางจุด"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "พบความไม่สม่ำเสมอของระยะห่างหรือการจัดแนวหลายจุด และเริ่มทำให้ UI ดูไม่เป็นระบบ"
            },
            {
              "label": "ไม่ผ่าน",
              "description": "ไม่มีรูปแบบของระยะห่าง/การจัดแนวที่ชัดเจน และทำให้ UI ดูไม่เป็นระบบ"
            }
          ]
        },
        {
          "id": "rc-uxui-4",
          "name": "C4 · Component Consistency & Design System / ความสม่ำเสมอของ Component และ Design System",
          "description": "การใช้ Component, Style และ Design System อย่างสม่ำเสมอ",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "ใช้ Color Styles, Typography Styles และ Components/Variants อย่างเป็นระบบ องค์ประกอบที่มีหน้าที่เดียวกันมีรูปแบบสอดคล้องกันทุกหน้าจอ"
            },
            {
              "label": "พอใช้",
              "description": "โดยรวมมีความสม่ำเสมอ แต่มีความแตกต่างเล็กน้อยบางองค์ประกอบ หรือมีบางส่วนที่ไม่ได้ใช้ Style/Component"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "พบความแตกต่างของ Component, สี หรือ Typography หลายจุดโดยไม่มีเหตุผลที่ชัดเจน"
            },
            {
              "label": "ไม่ผ่าน",
              "description": "แต่ละหน้าจอมีรูปแบบแตกต่างกันอย่างชัดเจน ไม่มี Design System หรือรูปแบบร่วมที่สม่ำเสมอ"
            }
          ]
        },
        {
          "id": "rc-uxui-5",
          "name": "C5 · Visual Hierarchy / ลำดับความสำคัญทางสายตา",
          "description": "หน้าจอบอกชัดเพียงใดว่าอะไรสำคัญที่สุด",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "สามารถแยก Primary/Secondary information และ Primary Action ได้ชัดเจน ขนาด สี น้ำหนัก และตำแหน่งช่วยนำสายตาได้เหมาะสม"
            },
            {
              "label": "พอใช้",
              "description": "ลำดับความสำคัญโดยรวมชัดเจน แต่มีบางส่วนที่แยกความสำคัญได้ไม่ชัด"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "มีหลายส่วนที่มีความสำคัญทางสายตาใกล้เคียงกัน ทำให้ผู้ใช้ไม่รู้ว่าควรสนใจหรือทำสิ่งใดก่อน"
            },
            {
              "label": "ไม่ผ่าน",
              "description": "ไม่มีลำดับความสำคัญที่ชัดเจน ทำให้ยากต่อการทำความเข้าใจหน้าจอ"
            }
          ]
        },
        {
          "id": "rc-uxui-6",
          "name": "C6 · Typography, Color & Accessibility / ตัวอักษร สี และ Accessibility",
          "description": "ตัวอักษรอ่านง่าย สีสม่ำเสมอ และ Contrast เพียงพอ",
          "maxPoints": 15,
          "weight": 15,
          "levels": [
            {
              "label": "ดีมาก",
              "description": "ตัวอักษรอ่านง่าย ขนาดและน้ำหนักเหมาะสม สีมีความสม่ำเสมอ Contrast เพียงพอ และไม่ใช้สีเพียงอย่างเดียวในการสื่อความหมาย"
            },
            {
              "label": "พอใช้",
              "description": "โดยรวมอ่านง่ายและเข้าถึงได้ แต่มีปัญหาเล็กน้อยบางจุด เช่น ขนาดตัวอักษรหรือ Contrast บางส่วน"
            },
            {
              "label": "ต้องปรับปรุง",
              "description": "มีปัญหาด้านการอ่านหรือ Accessibility หลายจุด เช่น ตัวอักษรเล็ก Contrast ต่ำ หรือใช้สีที่สื่อความหมายไม่ชัด"
            },
            {
              "label": "ไม่ผ่าน",
