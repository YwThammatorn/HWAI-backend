// HWAI Agent — data model for the admin screens (/admin/users, /admin/courses, /admin/curriculum).
// Shapes mirror the frontend types in HWAI-frontend/src/lib/{curriculum,courses,managed-teachers,cohort-students}.ts;
// the API keeps the frontend's names (ManagedTeacher → /api/managed-teachers, CohortStudent → /api/cohort-students),
// the database uses plain ones (teachers, students).
//
// Naming: models/fields are camelCase in code and snake_case in PostgreSQL (@map / @@map), so SQL needs no quoting.
// IDs are plain strings (not the uuid type) because the frontend generates ids client-side for optimistic
// updates and the mock data uses readable ids like "cv-ce-2569".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Program {
  CECS
  CEI
  CE

  @@map("program")
}

enum AccountStatus {
  active
  inactive

  @@map("account_status")
}

enum TeacherRole {
  teacher
  ta

  @@map("teacher_role")
}

enum CourseStatus {
  active
  archived

  @@map("course_status")
}

// HWAI-frontend/src/components/CourseIcon.tsx COURSE_ICON_KEYS
enum CourseIcon {
  book
  chart
  flask
  code
  palette
  laptop
  graduation
  globe

  @@map("course_icon")
}

// Frontend Term is 1 | 2 | 3 | "summer" — mapped in src/lib/serialize.ts. Stored as '1' / '2' / '3' / 'summer'.
enum Term {
  T1     @map("1")
  T2     @map("2")
  T3     @map("3")
  SUMMER @map("summer")

  @@map("term")
}

model CurriculumVersion {
  id            String           @id @default(uuid())
  program       Program
  label         String
  effectiveFrom Int              @map("effective_from") // พ.ศ.
  effectiveTo   Int?             @map("effective_to") // null = still in use
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  templates     CourseTemplate[]
  students      Student[]

  @@map("curriculum_versions")
}

// รายวิชาในหลักสูตร — the abstract subject a curriculum offers.
model CourseTemplate {
  id                  String               @id @default(uuid())
  curriculumVersionId String               @map("curriculum_version_id")
  curriculumVersion   CurriculumVersion    @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  code                String
  name                String
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  courses             Course[]
  rubricLibrary       RubricLibraryEntry[]

  @@index([curriculumVersionId])
  @@map("course_templates")
}

// รายวิชาที่เปิดสอน — one *section* offering of a subject in a term (see HWAI-frontend/src/lib/courses.ts).
model Course {
  id                String            @id @default(uuid())
  name              String
  description       String            @default("")
  status            CourseStatus      @default(active)
  coverColor        String            @map("cover_color")
  icon              CourseIcon        @default(book)
  code              String?
  courseTemplateId  String?           @map("course_template_id")
  courseTemplate    CourseTemplate?   @relation(fields: [courseTemplateId], references: [id], onDelete: SetNull)
  academicYear      Int?              @map("academic_year")
  term              Term?
  sectionNumber     String?           @map("section_number")
  schedule          String?
  room              String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  teachers          CourseTeacher[]
  enrollments       Enrollment[]
  gradingCategories GradingCategory[]
  assignments       Assignment[]
  studentGroups     StudentGroup[]
  sectionRoles      SectionRole[]
  clos              Clo[]

  @@index([courseTemplateId])
  @@map("courses")
}

// อาจารย์ / TA (ManagedTeacher on the frontend).
model Teacher {
  id           String          @id @default(uuid())
  title        String?
  name         String
  email        String          @unique
  role         TeacherRole     @default(teacher)
  status       AccountStatus   @default(active)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  courses      CourseTeacher[]
  sectionRoles SectionRole[]

  @@map("teachers")
}

// Which teachers are assigned to which course section (ManagedTeacher.courseIds on the frontend).
model CourseTeacher {
  courseId   String   @map("course_id")
  teacherId  String   @map("teacher_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([courseId, teacherId])
  @@index([teacherId])
  @@map("course_teachers")
}

// นักศึกษา — account-level record (CohortStudent on the frontend).
model Student {
  id                  String             @id @default(uuid())
  studentId           String             @unique @map("student_id") // institutional id e.g. "69070101"
  title               String?
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  email               String             @unique // how sign-in finds the student (always studentId@kmitl.ac.th)
  program             String
  status              AccountStatus      @default(active)
  curriculumVersionId String?            @map("curriculum_version_id")
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  sectionRoles        SectionRole[]

  @@map("students")
}

// ── Course content: roster, grading, assignments, submissions ────────────────
// Student references below (Enrollment.studentId, Submission.studentId, StudentGroup.memberStudentIds)
// hold the institutional student id (students.student_id, e.g. "69070101") as plain text — the same
// value the frontend keys on — not a foreign key.

enum EnrollmentStatus {
  enrolled
  withdrawn
  addedMidterm @map("added-midterm")

  @@map("enrollment_status")
}

// A student on one course section's roster (Student in HWAI-frontend/src/lib/students.ts).
model Enrollment {
  id               String            @id @default(uuid())
  courseId         String            @map("course_id")
  course           Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId        String            @map("student_id")
  firstName        String            @map("first_name")
  lastName         String            @map("last_name")
  email            String
  sequenceNumber   Int?              @map("sequence_number") // ลำดับในวิชา — new students continue the numbering
  enrollmentStatus EnrollmentStatus? @map("enrollment_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("enrollments")
}

// หมวดคะแนน — share of the course grade (weights of a course should add up to 100).
model GradingCategory {
  id          String       @id @default(uuid())
  courseId    String       @map("course_id")
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name        String
  weight      Float
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]

  @@index([courseId])
  @@map("grading_categories")
}

enum SubmissionFileType {
  figma
  pdf
  image

  @@map("submission_file_type")
}

enum SubmissionType {
  individual
  group

  @@map("submission_type")
}

// How the teacher grades an assignment: start the AI on every waiting submission, or grade by hand.
enum GradingMode {
  ai
  manual

  @@map("grading_mode")
}

model Assignment {
  id               String               @id @default(uuid())
  courseId         String               @map("course_id")
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name             String
  description      String               @default("")
  /// Teacher reference files/images/links: AssignmentAttachment[] (see src/lib/content.ts).
  attachments      Json?
  dueDate          DateTime?            @map("due_date") @db.Date // none for an exam
  maxPoints        Float                @map("max_points")
  categoryId       String?              @map("category_id")
  category         GradingCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  acceptsFiles     Boolean              @default(true) @map("accepts_files")
  fileTypes        SubmissionFileType[] @map("file_types")
  submissionType   SubmissionType       @default(individual) @map("submission_type")
  maxGroupSize     Int?                 @map("max_group_size")
  /// Kept as the frontend manages it (its rubric list, in order); rubrics also point back via assignment_id.
  rubricIds        String[]             @map("rubric_ids")
  gradingFinalized Boolean              @default(false) @map("grading_finalized") // "Finish & announce"
  isExam           Boolean              @default(false) @map("is_exam")
  gradingMode      GradingMode?         @map("grading_mode") // null = not chosen yet
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  rubrics          Rubric[]
  submissions      Submission[]
  studentGroups    StudentGroup[]
  calibrationRuns  CalibrationRun[]
  libraryEntries   RubricLibraryEntry[]

  @@index([courseId])
  @@index([categoryId])
  @@map("assignments")
}

model Rubric {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  /// RubricCriterion[] with their levels (see src/lib/content.ts).
  criteria     Json
  /// How the AI is corrected on this rubric, from the Calibration page: { [criterionId]: levels to move }.
  aiOffsets    Json?      @map("ai_offsets")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([assignmentId])
  @@map("rubrics")
}

enum SubmissionStatus {
  notGraded  @map("not_graded")
  needReview @map("need_review")
  graded

  @@map("submission_status")
}

// One student's hand-in for one assignment. Group work gives every member their own row sharing group_id.
model Submission {
  id                 String           @id @default(uuid())
  assignmentId       String           @map("assignment_id")
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String           @map("student_id")
  studentName        String           @map("student_name") // denormalized for display, as on the frontend
  email              String
  submittedAt        DateTime         @map("submitted_at")
  fileUrl            String?          @map("file_url") // legacy single link
  attachments        Json?
  aiScore            Float?           @map("ai_score")
  instructorScore    Float?           @map("instructor_score")
  instructorComment  String           @default("") @map("instructor_comment")
  criterionComments  Json?            @map("criterion_comments") // { [criterionId]: string }
  criterionScores    Json?            @map("criterion_scores") // { [criterionId]: number }
  aiCriterionScores  Json?            @map("ai_criterion_scores") // the AI's own { [criterionId]: number }
  externalUseConsent Boolean          @default(false) @map("external_use_consent")
  status             SubmissionStatus @default(notGraded)
  groupId            String?          @map("group_id") // not a FK: kept even if the team is later dissolved
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

// A team for one group assignment.
model StudentGroup {
  id               String     @id @default(uuid())
  assignmentId     String     @map("assignment_id")
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  courseId         String     @map("course_id")
  course           Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name             String
  memberStudentIds String[]   @map("member_student_ids")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([assignmentId])
  @@index([courseId])
  @@map("student_groups")
}

// Uploaded files (assignment attachments and submissions). An attachment with source "upload"
// stores this id as its `ref`; the file is served at GET /api/files/:id.
model StoredFile {
  id         String   @id @default(uuid())
  name       String
  mimeType   String   @map("mime_type")
  size       Int
  data       Bytes
  /// Email of whoever uploaded it — only they (or an admin) may delete it. Null for files from before sign-in.
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("files")
}

// ── Course staff and outcomes ────────────────────────────────────────────────

enum SectionRoleType {
  teacher
  ta
  coTeacher @map("co-teacher")

  @@map("section_role_type")
}

// A collaborator on one course section (SectionRole in HWAI-frontend/src/lib/section-roles.ts):
// a TA is a student, a co-teacher is a teacher. The frontend's single `accountId` is stored as
// exactly one of teacher_id / student_id (CHECK constraint in the migration), so deleting the
// teacher or student removes their roles too. The primary teacher comes from course_teachers.
model SectionRole {
  id          String          @id @default(uuid())
  courseId    String          @map("course_id")
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   String?         @map("teacher_id")
  teacher     Teacher?        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String?         @map("student_id")
  student     Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role        SectionRoleType
  /// Overrides the role's default permissions when set: { canManageRoster, canEditSettings, canPublishScores }.
  permissions Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([courseId, teacherId])
  @@unique([courseId, studentId])
  @@index([teacherId])
  @@index([studentId])
  @@map("section_roles")
}

// Course Learning Outcome (CLO in HWAI-frontend/src/lib/clo.ts). Codes aren't unique: the CLO page allows repeats.
model Clo {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code      String
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([courseId])
  @@map("clos")
}

// ── Rubric tools: the reuse library and AI calibration ───────────────────────

// A rubric the teacher saved for reuse (RubricLibraryEntry in HWAI-frontend/src/lib/rubricLibrary.ts), per subject
// so next year's section of the same subject finds it. No subject = offered for every course; deleting the subject
// deletes its entries (rather than turning them into "every course" ones).
model RubricLibraryEntry {
  id                 String          @id @default(uuid())
  name               String
  courseTemplateId   String?         @map("course_template_id")
  courseTemplate     CourseTemplate? @relation(fields: [courseTemplateId], references: [id], onDelete: Cascade)
  /// RubricCriterion[] as in a rubric, without grading data.
  criteria           Json
  /// Where it was saved from — provenance only, kept as null if that assignment goes.
  sourceAssignmentId String?         @map("source_assignment_id")
  sourceAssignment   Assignment?     @relation(fields: [sourceAssignmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([courseTemplateId])
  @@map("rubric_library_entries")
}

// One calibration of the AI on an assignment (CalibrationRun in HWAI-frontend/src/lib/calibration.ts): the teacher
// grades sample work blind, then compares with the AI per criterion.
model CalibrationRun {
  id             String     @id @default(uuid())
  assignmentId   String     @map("assignment_id")
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// One work item per entry — a submission id, or a team's key for a group assignment.
  sampleIds      String[]   @map("sample_ids")
  /// sample id → criterion id → level (0 = best).
  teacherLevels  Json       @map("teacher_levels")
  completedAt    DateTime?  @map("completed_at")
  /// "Use these values" was pressed: when, and the offsets saved on the rubric.
  appliedAt      DateTime?  @map("applied_at")
  appliedOffsets Json?      @map("applied_offsets")
  createdAt      DateTime   @map("created_at") // set by the client, kept as given
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([assignmentId])
  @@map("calibration_runs")
}

// ── Sign-in ──────────────────────────────────────────────────────────────────

// Who may use the admin pages. A person's other roles come from the account tables by email:
// teachers (teacher / TA), students, and section_roles for TAs / co-teachers.
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  /// A demo admin is only an admin while demo sign-in is on — real (Google) sign-in never gets it.
  demo      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored, so a leaked
// database can't be used to sign in. Deleting the row signs that browser out.
model Session {
  id         String   @id // sha256(token), hex
  email      String
  /// Signed in through the demo shortcut (no password / Google) — only possible while DEMO_LOGIN is on.
  demo       Boolean  @default(false)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([email])
  @@map("sessions")
}
