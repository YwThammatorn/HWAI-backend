# PostgreSQL connection string
DATABASE_URL="postgresql://hwai:hwai@localhost:5432/hwai?schema=public"

PORT=4000
# Comma-separated list of origins allowed to call the API (the Next.js frontend)
CORS_ORIGIN="http://localhost:3000"

# Demo sign-in (POST /api/auth/demo-login): sign in as an allow-listed account without Google.
# Off unless "true", and always off when NODE_ENV=production. It skips only the sign-in step —
# the account keeps its normal permissions. Demo sessions last 8 hours.
DEMO_LOGIN=false
# Comma-separated emails demo sign-in may use
DEMO_ACCOUNTS="somsak.c@kmitl.ac.th,69070101@kmitl.ac.th"
# "true" behind a reverse proxy, so the demo sign-in log shows the client's IP
TRUST_PROXY=false

# Google sign-in (accounts @kmitl.ac.th only). The OAuth client's "Authorized JavaScript origins" must
# list the frontend's origin. Leave empty to turn Google sign-in off. (A client ID isn't a secret.)
GOOGLE_CLIENT_ID="217226133588-nj0h4oqftr234v2d7a5hb8tjvcjt63k3.apps.googleusercontent.com"
